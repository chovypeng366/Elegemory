{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elegemory",
  "version": "0.4.3",
  "identifier": "com.elegemory.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Elegemory",
        "width": 1180,
        "height": 800,
        "minWidth": 880,
        "minHeight": 580,
        "center": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#F5F0E8",
        "shadow": true,
        "dragDropEnabled": false
      },
      {
        "label": "capture",
        "title": "Elegemory 速记",
        "width": 460,
        "height": 340,
        "minWidth": 460,
        "minHeight": 340,
        "resizable": false,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/assets/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
